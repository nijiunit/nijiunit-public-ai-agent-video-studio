# Copy this file to .env. Never commit the copied file.
GEMINI_API_KEY=

# Optional model overrides. Availability and pricing may change.
STORY_MODEL=gemini-3.6-flash
IMAGE_MODEL=gemini-3.1-flash-image
VIDEO_MODEL=gemini-omni-flash-preview
TTS_MODEL=gemini-3.1-flash-tts-preview

# Optional character registry override.
# CHARACTER_REGISTRY_DIR=examples/space-friends/characters
MAX_CHARACTER_REFERENCE_IMAGES=6
