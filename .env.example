# Copy this file to .env. Never commit the copied file.
GEMINI_API_KEY=

# Optional. Required only when the user explicitly asks to read current public
# YouTube comments. Enable YouTube Data API for this key and never paste it into
# chat. Dated catalog comments work without this key.
YOUTUBE_DATA_API_KEY=

# Optional local model overrides. Leave these blank to use the current models
# from the verified nijiunit website production profile.
STORY_MODEL=
IMAGE_MODEL=
VIDEO_MODEL=
TTS_MODEL=
ASR_MODEL=
TUTORIAL_MODEL=

# Optional character registry override.
# CHARACTER_REGISTRY_DIR=C:\path\to\your\characters
